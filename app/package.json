{
  "name": "the-last-query-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The Last Query - Police Console (phone companion app, no server: MQTT relays)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:pages": "tsc -p tsconfig.json --noEmit && vite build --outDir ../docs --emptyOutDir && node scripts/pages-config.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "mqtt": "^5.10.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}

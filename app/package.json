{
  "name": "the-last-query-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The Last Query - Police Console (phone companion app)",
  "scripts": {
    "dev": "concurrently -k -n server,client -c red,white \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "PORT=3001 tsx watch --exclude .games.json --exclude .games.json.tmp server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "express": "^4.22.3",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  }
}

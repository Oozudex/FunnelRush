{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tlq-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev"
      ],
      "port": 5173
